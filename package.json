{
  "name": "manga-translator-pro",
  "private": true,
  "version": "0.5.0-beta.2",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "node scripts/copy-ocr.mjs && node scripts/copy-translation.mjs && node scripts/gen-build-info.cjs",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "clean": "rm -rf extension/options",
    "lint": "tsc --noEmit",
    "package": "npm run build && python scripts/package.py",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e/run.mjs",
    "bench": "node tests/e2e/run.mjs --bench"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
